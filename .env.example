# Copy this file to .env and fill in real values.

# --- LLM (required) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Web search tool ---
# Optional. If unset, the Researcher automatically falls back to keyless
# DuckDuckGo search (via the `ddgs` package) - no signup needed.
TAVILY_API_KEY=

# --- Episodic memory: real Redis ---
# Local Redis via Docker:  docker run -p 6379:6379 --name research-redis -d redis:7
REDIS_URL=redis://localhost:6379/0

# --- Semantic memory: Zep Cloud ---
# Sign up at https://www.getzep.com to get a key.
ZEP_API_KEY=

# "auto" (default) uses Redis/Zep when reachable and falls back to an
# in-memory store otherwise. Set to "local" to force the in-memory stores.
MEMORY_BACKEND=auto

# --- LangSmith tracing (Policy 5) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-research-assistant

# --- App tuning ---
MAX_RESEARCH_ITERATIONS=3
SQL_ROW_LIMIT=200

# --- API security: Layer 1, required baseline (M5) ---
# Every FastAPI endpoint checks this against the X-API-Key request header.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- API security: Layer 2, required JWT (M6 - no longer optional) ---
# Signs/verifies the bearer token issued by POST /auth/login. Every
# business route (/research*, /approvals*) requires BOTH this AND the
# API key above - neither replaces the other. All four values below must
# be set or the app (API + UI) will 401 on every real request.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
DEMO_USERNAME=demo
DEMO_PASSWORD=

# --- Guardrails (M6): prompt-injection/jailbreak/toxicity detection ---
# true (default) = block unsafe prompts before they reach the pipeline.
# Set to false only to reproduce an "undefended" baseline for red-team
# comparison - never in a real deployment.
BLOCK_ON_INJECTION=true

# --- Docker Compose / Cloud Run wiring ---
# Leave both blank for local/CLI use (embedded Chroma at ./chroma_store).
# docker-compose.yml sets these itself (CHROMA_SERVER_HOST=vectorstore);
# only fill these in by hand if you're pointing at a Chroma server that
# isn't the one docker-compose.yml starts for you.
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=8000
